# Empire State Hub — environment template
# Copy to .env.local (gitignored) and fill with real values. NEVER commit real secrets.
# SECURITY RULE: none of these may be prefixed with NEXT_PUBLIC_ — all are server-only.
# They are read exclusively in Server Components / Route Handlers, never shipped to the browser.

# --- Notion (read-only) ---
# Internal integration token. Share all 6 databases with this integration in the Notion UI.
NOTION_TOKEN=
# Resolve the real DATABASE ids (not the collection:// data-source ids). Fill during M2.
NOTION_DB_EVENTS=
NOTION_DB_PEOPLE=
NOTION_DB_COMPANIES=
NOTION_DB_TOPICS=
NOTION_DB_CONTENT_DRAFTS=
NOTION_DB_PROJECT_IDEAS=

# --- Linear (read-only) ---
LINEAR_API_KEY=
LINEAR_TEAM_KEY=YED

# --- Google Calendar: DROPPED for v1 — events view is sourced from the Notion Events DB. ---

# --- Ops gate (v1) — Basic-auth password for /ops; set in Vercel before deploy ---
OPS_PASSWORD=

# --- Auth.js (M3 — full GitHub-OAuth gate for /ops) ---
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Single allow-listed operator email. Only this address may access /ops.
OPS_ALLOWED_EMAIL=

# --- GitHub (read-only) — OPTIONAL: live /changelog from skills-repo commits ---
# Without it, /changelog uses committed JSON snapshots. Fine-grained PAT, read-only Contents.
GITHUB_TOKEN=
GITHUB_REPO=AlexYedi/Empire_State_Events_Pipeline_Take_3

# --- PostHog — dedicated Empire State project (NOT gtm_os) ---
# Read path (/ops rigor dashboard): PERSONAL (phx_) key needs query:read scope; PROJECT_API_KEY (phs_) is a fallback.
# Capture path (Take-3 telemetry hooks): PROJECT_TOKEN (phc_) public write key.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_ID=524367
POSTHOG_HOST=https://us.posthog.com

# --- On-demand revalidation webhook (M2/M4) ---
REVALIDATE_SECRET=

# --- Market-Intelligence graph (read-only, ENGINE project `empire state ai` / oicikjyzmxqfomrrqkvf) ---
# Server-only. NEVER prefix with NEXT_PUBLIC_ — the key is an sb_secret_ key that bypasses RLS.
MARKET_INTEL_SUPABASE_URL=https://oicikjyzmxqfomrrqkvf.supabase.co
MARKET_INTEL_SUPABASE_KEY=
