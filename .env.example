# Empire State Hub — environment template
# Copy to .env.local (gitignored) and fill with real values. NEVER commit real secrets.
# SECURITY RULE: none of these may be prefixed with NEXT_PUBLIC_ — all are server-only.
# They are read exclusively in Server Components / Route Handlers, never shipped to the browser.

# --- Notion (read-only) ---
# Internal integration token. Share all 6 databases with this integration in the Notion UI.
NOTION_TOKEN=
# Resolve the real DATABASE ids (not the collection:// data-source ids). Fill during M2.
NOTION_DB_EVENTS=
NOTION_DB_PEOPLE=
NOTION_DB_COMPANIES=
NOTION_DB_TOPICS=
NOTION_DB_CONTENT_DRAFTS=
NOTION_DB_PROJECT_IDEAS=

# --- Linear (read-only) ---
LINEAR_API_KEY=
LINEAR_TEAM_KEY=YED

# --- Google Calendar (read-only, "Going to Events" calendar) ---
# Service-account JSON (single-line) OR a path; calendar id kept in env, not committed in code.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Auth.js (M3 — gates /ops) ---
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Single allow-listed operator email. Only this address may access /ops.
OPS_ALLOWED_EMAIL=

# --- On-demand revalidation webhook (M2/M4) ---
REVALIDATE_SECRET=
