# Empire State Hub — environment template
# Copy to .env.local (gitignored) and fill with real values. NEVER commit real secrets.
# SECURITY RULE: none of these may be prefixed with NEXT_PUBLIC_ — all are server-only.
# They are read exclusively in Server Components / Route Handlers, never shipped to the browser.

# --- Notion (read-only) ---
# Internal integration token. Share all 5 databases with this integration in the Notion UI.
NOTION_TOKEN=
# Resolve the real DATABASE ids (not the collection:// data-source ids). Fill during M2.
NOTION_DB_EVENTS=
NOTION_DB_PEOPLE=
NOTION_DB_COMPANIES=
NOTION_DB_TOPICS=
NOTION_DB_CONTENT_DRAFTS=

# --- Linear (read-only) ---
LINEAR_API_KEY=
LINEAR_TEAM_KEY=YED

# --- Google Calendar: DROPPED for v1 — events view is sourced from the Notion Events DB. ---

# --- Ops gate — Basic-auth password for /ops; set in Vercel before deploy ---
# Production reads OPS_PASSWORD. Preview falls back to OPS_PASSWORD_PREVIEW (Vercel wouldn't
# scope a second OPS_PASSWORD to Preview). Unset in production = /ops returns 404.
OPS_PASSWORD=
OPS_PASSWORD_PREVIEW=

# --- Scripts only (not read by the app) ---
# gen-system-map / verify-system-map default to the sibling pipeline checkout; override here.
# PIPELINE_DIR=/path/to/Empire_State_Events_Pipeline_Take_3
# GEN_DATE=YYYY-MM-DD   (pins system-map generated_at; defaults to today)
